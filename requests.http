@order = http://localhost:8080
@inventory = http://localhost:8081
@payment = http://localhost:8082

# The saga resolves asynchronously. A POST always returns PENDING, and a GET run
# immediately afterwards may still show PENDING or AWAITING_PAYMENT. Re-run the GET a
# moment later to see the final CONFIRMED or CANCELLED state.
#
# Flow: order.created -> stock.reserved -> payment.succeeded  => CONFIRMED
#                                       -> payment.failed     => CANCELLED + stock.release.requested
#       order.created -> stock.rejected                        => CANCELLED (nothing to release)

### Stock before, SKU-001
GET {{inventory}}/api/inventory/SKU-001

### Stock before, SKU-003
GET {{inventory}}/api/inventory/SKU-003

### ---------- Happy path: 25000, under the 50000 decline threshold ----------

### Place a small order -> 201 PENDING
# @name smallOrder
POST {{order}}/api/orders
Content-Type: application/json

{
  "restaurantId": "REST-42",
  "items": [
    { "sku": "SKU-001", "quantity": 2 }
  ]
}

### Read it back -> CONFIRMED
GET {{order}}/api/orders/{{smallOrder.response.body.$.reference}}

### Stock reduced by 2
GET {{inventory}}/api/inventory/SKU-001

### Payment record -> SUCCEEDED
GET {{payment}}/api/payments/{{smallOrder.response.body.$.reference}}

### ---------- Compensation path: 62500, over the decline threshold ----------

### Place a large order -> 201 PENDING
# @name largeOrder
POST {{order}}/api/orders
Content-Type: application/json

{
  "restaurantId": "REST-42",
  "items": [
    { "sku": "SKU-001", "quantity": 5 }
  ]
}

### Read it back -> CANCELLED, cancellationReason "Amount exceeds card limit"
GET {{order}}/api/orders/{{largeOrder.response.body.$.reference}}

### Stock back to where it was: deducted on reservation, restored by the release
GET {{inventory}}/api/inventory/SKU-001

### Payment record -> FAILED
GET {{payment}}/api/payments/{{largeOrder.response.body.$.reference}}

### ---------- Rejection path: more stock than exists, no release ----------

### Order 999 of SKU-003 -> 201 PENDING
# @name rejectedOrder
POST {{order}}/api/orders
Content-Type: application/json

{
  "restaurantId": "REST-42",
  "items": [
    { "sku": "SKU-003", "quantity": 999 }
  ]
}

### Read it back -> CANCELLED with a stock reason
GET {{order}}/api/orders/{{rejectedOrder.response.body.$.reference}}

### SKU-003 unchanged: nothing was ever deducted, so nothing is released
GET {{inventory}}/api/inventory/SKU-003

### No payment was ever attempted -> 404
GET {{payment}}/api/payments/{{rejectedOrder.response.body.$.reference}}

### ==================== Phase 5: reliability ====================

# Dead letter topics are named after the original with a .dlq suffix. A record lands there
# after three attempts with exponential backoff, or immediately if its payload could never
# be deserialised.

### Dead letter topics and their message counts
GET {{order}}/api/admin/dlq/topics

### Messages in one dead letter topic, with the failure reason from the exception headers
GET {{order}}/api/admin/dlq/order.created.dlq

### Replay a dead letter topic back to the topic it failed on.
# Safe because every listener claims the eventId in the same transaction as its work, so a
# replayed event that already succeeded is skipped rather than applied twice.
POST {{order}}/api/admin/dlq/order.created.dlq/replay

### Orders stuck in a non-terminal state for longer than orders.stuck-after
GET {{order}}/api/admin/stuck-orders
