@auth = http://localhost:8083
@order = http://localhost:8080
@inventory = http://localhost:8081
@payment = http://localhost:8082

# Seeded dev accounts (passwords are dev-only, hashes are seeded as BCrypt):
#   alice@orqentra.test / alice-pass  -> RESTAURANT, Alice Trattoria
#   bob@orqentra.test   / bob-pass    -> RESTAURANT, Bob Bistro
#   admin@orqentra.test / admin-pass  -> ADMIN
#
# The saga resolves asynchronously: a POST returns PENDING and a GET run immediately after
# may still show PENDING or AWAITING_PAYMENT. Re-run the GET to see the final state.
#
# The order's restaurant comes from the token's restaurantRef claim. There is no
# restaurantId field in the request body any more, so it cannot be spoofed.

### ==================== Auth ====================

### Register a brand new restaurant
POST {{auth}}/api/auth/register
Content-Type: application/json

{
  "email": "carol@orqentra.test",
  "password": "carol-pass",
  "restaurantName": "Carol Cafe"
}

### Registering the same email again -> 409
POST {{auth}}/api/auth/register
Content-Type: application/json

{
  "email": "carol@orqentra.test",
  "password": "carol-pass",
  "restaurantName": "Carol Cafe Again"
}

### Log in as restaurant A (Alice)
# @name login
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@orqentra.test",
  "password": "alice-pass"
}

### Log in as restaurant B (Bob)
# @name loginB
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "bob@orqentra.test",
  "password": "bob-pass"
}

### Log in as the admin
# @name loginAdmin
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@orqentra.test",
  "password": "admin-pass"
}

### Who am I
GET {{auth}}/api/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### Wrong password -> 401, identical body to the unknown-email case below
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@orqentra.test",
  "password": "not-the-password"
}

### Unknown email -> 401, same body, so registered emails cannot be discovered
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@orqentra.test",
  "password": "not-the-password"
}

### ==================== Negative cases ====================

### No token at all -> 401 ProblemDetail
GET {{order}}/api/orders

### Malformed token -> 401 ProblemDetail
GET {{order}}/api/orders
Authorization: Bearer not-a-real-token

### ==================== The saga, authenticated ====================

### Stock before, SKU-001
GET {{inventory}}/api/inventory/SKU-001
Authorization: Bearer {{login.response.body.$.token}}

### Place a small order as restaurant A -> 201 PENDING, no restaurantId in the body
# @name smallOrder
POST {{order}}/api/orders
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "items": [
    { "sku": "SKU-001", "quantity": 2 }
  ]
}

### Read it back -> CONFIRMED, restaurantId matches the token's restaurantRef
GET {{order}}/api/orders/{{smallOrder.response.body.$.reference}}
Authorization: Bearer {{login.response.body.$.token}}

### Stock reduced by 2
GET {{inventory}}/api/inventory/SKU-001
Authorization: Bearer {{login.response.body.$.token}}

### Payment record -> SUCCEEDED
GET {{payment}}/api/payments/{{smallOrder.response.body.$.reference}}
Authorization: Bearer {{login.response.body.$.token}}

### This restaurant's own orders, most recent first
GET {{order}}/api/orders?page=0&size=10
Authorization: Bearer {{login.response.body.$.token}}

### ==================== Compensation ====================

### Place a large order (62500, over the decline threshold)
# @name largeOrder
POST {{order}}/api/orders
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "items": [
    { "sku": "SKU-001", "quantity": 5 }
  ]
}

### Read it back -> CANCELLED, "Amount exceeds card limit"
GET {{order}}/api/orders/{{largeOrder.response.body.$.reference}}
Authorization: Bearer {{login.response.body.$.token}}

### Stock returned to its pre-order level by the release
GET {{inventory}}/api/inventory/SKU-001
Authorization: Bearer {{login.response.body.$.token}}

### ==================== Cross-tenant ====================

### Restaurant B asks for restaurant A's order -> 404, not 403.
# A 403 would confirm the reference exists, which is enough to enumerate other tenants.
GET {{order}}/api/orders/{{smallOrder.response.body.$.reference}}
Authorization: Bearer {{loginB.response.body.$.token}}

### The admin can read the same order -> 200
GET {{order}}/api/orders/{{smallOrder.response.body.$.reference}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### ==================== Admin ====================

### Dead letter topics with a RESTAURANT token -> 403
GET {{order}}/api/admin/dlq/topics
Authorization: Bearer {{login.response.body.$.token}}

### Dead letter topics with an ADMIN token -> 200
GET {{order}}/api/admin/dlq/topics
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Messages in a dead letter topic
GET {{order}}/api/admin/dlq/order.created.dlq
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Replay a dead letter topic back to its original.
# Safe because every listener claims the eventId in the same transaction as its work.
POST {{order}}/api/admin/dlq/order.created.dlq/replay
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Orders stuck in a non-terminal state
GET {{order}}/api/admin/stuck-orders
Authorization: Bearer {{loginAdmin.response.body.$.token}}
