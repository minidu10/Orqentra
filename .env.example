# Copy this file to .env and change the values you need.
# Every value below is the default used when the variable is not set.

# Security - use a long random value in production
ORQENTRA_JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# Service URLs (used by the API gateway)
AUTH_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
INVENTORY_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Tracing
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLE_RATE=1.0

# Allowed web UI origins (CORS)
UI_ORIGIN_VITE=http://localhost:5173
UI_ORIGIN_CRA=http://localhost:3000
